# Copie para .env e ajuste. NUNCA versione o .env.

# --- Aplicação ---
CINEMATCH_ENV=local
CINEMATCH_LOG_LEVEL=INFO
CINEMATCH_LOG_JSON=true

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=cinematch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cinematch
# Porta no host (5432/5433 podem estar ocupadas por outros projetos)
POSTGRES_HOST_PORT=5434

# URL usada pela API/CLI rodando no HOST. No container, o compose sobrescreve o host para "postgres".
CINEMATCH_DATABASE_URL=postgresql+psycopg://cinematch:change-me@localhost:5434/cinematch

# --- API e frontend ---
API_HOST_PORT=8010
WEB_HOST_PORT=8088

# --- TMDB (Fase 1) ---
# Read Access Token (v4) em https://www.themoviedb.org/settings/api — preencha apenas no .env
TMDB_API_TOKEN=

# --- Bronze (respostas brutas). Retenção máxima TMDB: 180 dias (cinematch ingest purge-bronze)
CINEMATCH_BRONZE_DIR=data/bronze

# --- MLflow (tracking próprio do CineMatch; não reusar MLflow de outros projetos) ---
MLFLOW_HOST_PORT=5010
CINEMATCH_MLFLOW_TRACKING_URI=http://127.0.0.1:5010

# --- CORS da API (origens do frontend em dev; lista JSON) ---
# CINEMATCH_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# --- Banco no Azure (Database for PostgreSQL Flexible Server) ---
# Destino do scripts/migrate_db.sh (formato libpq; caracteres especiais da senha em URL-encoding):
# CINEMATCH_MIGRATION_TARGET_URL=postgresql://USUARIO:SENHA@SERVIDOR.postgres.database.azure.com:5432/cinematch?sslmode=require
# Depois da migração, CLI (host) e API (container) apontam para o Azure:
# CINEMATCH_DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@SERVIDOR.postgres.database.azure.com:5432/cinematch?sslmode=require
# CINEMATCH_API_DATABASE_URL=${CINEMATCH_DATABASE_URL}
# CINEMATCH_DB_CONNECT_TIMEOUT_S=10

# --- Login com Google (Google Cloud Console > APIs e serviços > Credenciais > OAuth 2.0) ---
# URIs de redirecionamento autorizados: http://localhost:5173/api/auth/google/callback
#                                       http://localhost:8088/api/auth/google/callback
# GOOGLE_CLIENT_ID e SECRET ficam só no .env. Prefixo CINEMATCH_ (configuração da aplicação):
# CINEMATCH_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# CINEMATCH_GOOGLE_CLIENT_SECRET=
