# /api passa pelo proxy do Vite (dev) ou do nginx (produção) até o FastAPI.
VITE_API_BASE_URL=/api
# true: dados fictícios em memória, sem backend
VITE_USE_MOCKS=false
# Destino do proxy /api no `npm run dev`
API_PROXY_TARGET=http://127.0.0.1:8010
# Apenas com mocks, para testar estados de erro (0 a 1)
VITE_MOCK_ERROR_RATE=0
